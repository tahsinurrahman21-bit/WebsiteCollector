# Normalise text files in the repository
* text=auto

# Windows scripts must keep CRLF line endings to run reliably
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Python and docs use LF in the repository
*.py   text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.yml  text eol=lf
*.spec text eol=lf

# Binary files
*.png binary
*.jpg binary
*.ico binary
*.pdf binary
*.zip binary
