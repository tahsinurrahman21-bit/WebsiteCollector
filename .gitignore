# ---------------------------------------------------------------
# Website Collector - files that must NOT be published
# ---------------------------------------------------------------

# Python virtual environment and bytecode (generated by setup.bat)
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.pyo

# Runtime data created by the app (large, machine-specific, may contain
# third-party website content and your browsing activity)
cache/
temp/
output/
logs/
browser_data/

# Personal / machine-specific state
settings.json
.settings-*.json
last_urls.txt

# Local development scratch area and old hand-made bundles
work/
deliverables/
VERIFICATION.md

# Third-party binaries (LibreOffice is ~1 GB with an MSI installer; it is
# optional and users install it themselves - see README)
tools/

# Packaging output (created by build_release.ps1 / PyInstaller)
build/
dist/
release/
*.spec.bak

# Archives and installers should go to GitHub Releases, not git
*.zip
*.7z
*.msi
*.exe

# Test and tooling caches
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Editors and operating system files
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store

# Secrets (none are used today - this is a safety net)
.env
.env.*
*.pem
*.key
